# ATLAS configuration. Copy to `.env` and adjust. Every value is optional.
# ATLAS runs fully without any keys; keyed sources stay visibly "disabled" until configured.

# --- Engine ---------------------------------------------------------------
# ATLAS_HOST=127.0.0.1
# ATLAS_PORT=8787
# ATLAS_DATA_DIR=./data/runtime
# ATLAS_OFFLINE=false            # true = never touch the network; serve cached data only
# ATLAS_FIRE_WINDOW_HOURS=48
# ATLAS_PROFILE=balanced         # eco | balanced | performance

# --- Optional free credentials -------------------------------------------
# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# ATLAS_FIRMS_MAP_KEY=

# ReliefWeb approved appname (free, requires approval): https://apidoc.reliefweb.int/parameters#appname
# ATLAS_RELIEFWEB_APPNAME=

# OpenAQ v3 API key (free): https://explore.openaq.org/register
# ATLAS_OPENAQ_API_KEY=

# --- Web client -----------------------------------------------------------
# VITE_ATLAS_API=http://127.0.0.1:8787
